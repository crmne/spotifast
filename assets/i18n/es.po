#~ msgid "Spotify can be slow on the shared app"
#~ msgstr "Spotify puede ir lento con la app compartida"

#~ msgid ""
#~ "Everyone using Spotifast shares one app, and Spotify slows it down when "
#~ "it's busy. Set up your own personal Spotify app and you won't have to "
