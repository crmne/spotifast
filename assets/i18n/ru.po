msgstr "Применить настройки"

#: src/ui/settings.rs:1384
msgid "Not using a proxy."
msgstr "Прокси не используется."

#: src/ui/settings.rs:1385
msgid "Using the system proxy."
msgstr "Используется системный прокси."

