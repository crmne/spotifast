#, rust-format
msgid "Installed skins are in {folder}. None of this kind yet."
msgstr "Geïnstalleerde skins staan in {folder}. Nog geen van dit soort."

#: src/ui/settings.rs:2090
msgid "MilkDrop window"
msgstr "MilkDrop-venster"

#: src/ui/settings.rs:2098
msgid ""
"A projectM visualiser for local playback. Open it here, from the top bar, "
"with Ctrl+Shift+K, or from the mini player's V menu. Press ? or F1 for its "
"shortcuts."
msgstr ""
"Een projectM-visualisatie voor lokaal afspelen. Open hem hier, via de "
"bovenste balk, met Ctrl+Shift+K of via het V-menu van de minispeler. Druk "
"op ? of F1 voor de sneltoetsen."

#: src/ui/settings.rs:2102
msgid ""
"A projectM visualiser for local playback. Open it here, from the top bar, "
"with Cmd+Shift+K, or from the mini player's V menu. Press ? or F1 for its "
"shortcuts."
msgstr ""
"Een projectM-visualisatie voor lokaal afspelen. Open hem hier, via de "
"bovenste balk, met Cmd+Shift+K of via het V-menu van de minispeler. Druk "
"op ? of F1 voor de sneltoetsen."

