msgid "Spotify's own player, running on this computer. Requires Premium."
msgstr "De eigen speler van Spotify, op deze computer. Vereist Premium."

#: src/ui/soloist.rs:809
msgid "Status"
msgstr "Status"

#: src/ui/soloist.rs:810
msgid "Version"
msgstr "Versie"

