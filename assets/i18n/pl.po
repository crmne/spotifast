msgstr "Kolorowa"

#: src/ui/settings.rs:939
msgctxt "tray icon"
msgid "White"
msgstr "Biała"

#: src/ui/settings.rs:940
msgctxt "tray icon"
msgid "Black"
msgstr "Czarna"

