msgstr "Pamięć"

#: src/ui/settings.rs:2284
msgid "Artwork cache"
msgstr "Pamięć podręczna okładek"

#. Translators: {folder} is the path of a cache folder.
#: src/ui/settings.rs:2286 src/ui/settings.rs:2292
#, rust-format
msgid "Stored in {folder}"
msgstr "Zapisane w {folder}"

#: src/ui/settings.rs:2299
msgid "Play history"
msgstr "Historia odtwarzania"

#. Translators: {file} is the path of the play history file.
#: src/ui/settings.rs:2303
#, rust-format
msgid "Tracks played here are stored in {file}. This file is never uploaded."
msgstr ""
"Utwory odtwarzane tutaj są zapisywane w {file}. Ten plik nigdy nie jest "
"wysyłany."

#: src/ui/settings.rs:2308
msgid "Sign-in"
msgstr "Logowanie"

#: src/ui/settings.rs:2311
msgid "Sign-ins are saved in the system credential store when available."
msgstr ""
"Dane logowania są zapisywane w systemowym magazynie poświadczeń, jeśli jest "
"dostępny."

#: src/ui/settings.rs:2323
msgid "Clear artwork"
msgstr "Wyczyść okładki"

#: src/ui/settings.rs:2337
msgid "Clear history"
msgstr "Wyczyść historię"

#: src/ui/settings.rs:2349 src/ui/show.rs:42
msgid "About"
msgstr "O programie"

#: src/ui/settings.rs:2352
msgid "Built with Rust, egui, and librespot. Not affiliated with Spotify."
msgstr "Zbudowano w Rust, egui i librespot. Niepowiązane ze Spotify."

#: src/ui/settings.rs:2354
