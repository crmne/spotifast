msgstr "W polu „Redirect URIs” dodaj dokładnie:"

#: src/ui/login.rs:514
msgid "Tick Web API, accept the terms, and save."
msgstr "Zaznacz „Web API”, zaakceptuj warunki i zapisz."

#: src/ui/login.rs:523
msgid "Paste the app's Client ID into the field and sign in."
msgstr "Wklej Client ID aplikacji w pole i zaloguj się."

#. Translators: shown on the Copy button for a moment after it copied.
#: src/ui/login.rs:558
msgid "Copied"
msgstr "Skopiowano"

#: src/ui/mod.rs:401
msgid "Spotify is being slow on the shared app."
msgstr "Spotify działa wolno we wspólnej aplikacji."

#: src/ui/mod.rs:404
msgid ""
"Spotifast no longer offers the shared app, and Spotify can stop accepting it "
"at any time. Set up your own free Spotify app and you won't have to wait."
msgstr ""
"Spotifast nie oferuje już wspólnej aplikacji, a Spotify może w każdej chwili "
"przestać ją akceptować. Skonfiguruj własną, darmową aplikację Spotify, a nie "
"trzeba będzie czekać."

