msgid "Status: {status}"
msgstr "Stan: {status}"

#: src/ui/settings.rs:699
msgid "Device name"
msgstr "Nazwa urządzenia"

#: src/ui/settings.rs:700
msgid "How this computer appears in Spotify Connect."
msgstr "Jak ten komputer jest widoczny w Spotify Connect."

#: src/ui/settings.rs:703
msgid "Audio quality"
msgstr "Jakość dźwięku"

#: src/ui/settings.rs:704
msgid "Higher bitrates use more data and cache space."
msgstr ""
"Wyższe bitrate’y zużywają więcej danych i miejsca w pamięci podręcznej."

#: src/ui/settings.rs:708
msgid "Keep loud and quiet tracks at a similar level."
msgstr "Utrzymuje głośne i ciche utwory na podobnym poziomie."

#: src/ui/settings.rs:712
msgid "Keep playing similar songs when your music ends."
msgstr "Odtwarzaj podobne utwory, gdy skończy się Twoja muzyka."

#: src/ui/settings.rs:716
msgid "Play tracks without silence between them."
msgstr "Odtwarza utwory bez ciszy między nimi."

#: src/ui/settings.rs:723
msgid ""
"Spotifast hides to the system tray. Quit from the tray menu or with Ctrl+Q."
msgstr ""
"Spotifast chowa się do zasobnika systemowego. Zamknij go z menu zasobnika "
"lub skrótem Ctrl+Q."

#: src/ui/settings.rs:728
msgid ""
"Spotifast hides to the menu bar. Quit from its menu-bar icon or with Cmd+Q."
msgstr ""
"Spotifast chowa się na pasek menu. Zamknij go ikoną na pasku menu lub "
"skrótem Cmd+Q."

#: src/ui/settings.rs:735
msgid "Checks GitHub once a day. No personal data is sent."
msgstr "Sprawdza GitHub raz dziennie. Żadne dane osobowe nie są wysyłane."

#: src/ui/settings.rs:738
msgid "Output buffer"
msgstr "Bufor wyjścia"

#: src/ui/settings.rs:741
msgid ""
"More buffering can prevent clicks on busy computers. Less buffering makes "
"controls respond sooner."
msgstr ""
"Większy bufor może zapobiec trzaskom na obciążonych komputerach. Mniejszy "
"bufor sprawia, że sterowanie reaguje szybciej."

#: src/ui/settings.rs:747
msgid "Save downloaded audio for later playback."
msgstr "Zapisuj pobrany dźwięk do późniejszego odtwarzania."

#: src/ui/settings.rs:750
msgid "Playback settings applied"
msgstr "Zastosowano ustawienia odtwarzania"

#: src/ui/settings.rs:755
msgid "Downloads in the background. You choose when to restart."
msgstr "Pobierane w tle. Ty decydujesz, kiedy uruchomić ponownie."

#: src/ui/settings.rs:759 src/ui/settings.rs:1006
msgid "MacBook notch widget"
msgstr "Widżet wycięcia w MacBooku"

#: src/ui/settings.rs:762
msgid "Show interactive Now Playing widget when hovering over the notch."
msgstr ""
"Pokaż interaktywny widżet Teraz odtwarzane po najechaniu kursorem na "
"wycięcie."

#: src/ui/settings.rs:766
msgid "Local files"
msgstr "Pliki lokalne"

#: src/ui/settings.rs:771
msgid ""
"When off, Spotifast lives in the menu bar and leaves Cmd+Tab. Open it from "
"its menu-bar icon."
msgstr ""
"Po wyłączeniu Spotifast działa tylko na pasku menu i nie pojawia się w "
"Cmd+Tab. Otwórz go ikoną na pasku menu."

#: src/ui/settings.rs:777
msgid "Tray icon"
msgstr "Ikona w zasobniku"

#: src/ui/settings.rs:778
msgid "White or black can match your panel or taskbar."
msgstr "Biała lub czarna pasuje do panelu lub paska zadań."

#: src/ui/settings.rs:799
msgid "Reconnect"
msgstr "Połącz ponownie"

#: src/ui/settings.rs:831
msgid "Normal · 96 kbps"
msgstr "Normalna · 96 kb/s"

#: src/ui/settings.rs:832
msgid "High · 160 kbps"
msgstr "Wysoka · 160 kb/s"

#: src/ui/settings.rs:833
msgid "Very high · 320 kbps"
msgstr "Bardzo wysoka · 320 kb/s"

