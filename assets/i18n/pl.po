msgstr "Uruchom ponownie lokalne odtwarzanie, aby zastosować te ustawienia."

#: src/ui/settings.rs:679
msgid "Download updates automatically"
msgstr "Pobieraj aktualizacje automatycznie"

#: src/ui/settings.rs:680
msgid "Show in Dock"
msgstr "Pokazuj w Docku"

#: src/ui/settings.rs:681
msgid "Start with your computer"
msgstr "Uruchamiaj z komputerem"

