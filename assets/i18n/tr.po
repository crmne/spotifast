msgstr "Yarım"

#: src/ui/settings.rs:2261
msgctxt "resolution"
msgid "Quarter"
msgstr "Çeyrek"

#: src/ui/settings.rs:2275
msgid "Equalizer"
msgstr "Ekolayzer"

