msgctxt "tray icon"
msgid "Colour"
msgstr "Renkli"

#: src/ui/settings.rs:893
msgctxt "tray icon"
msgid "White"
msgstr "Beyaz"

#: src/ui/settings.rs:894
msgctxt "tray icon"
msgid "Black"
msgstr "Siyah"

#: src/ui/settings.rs:1009 src/ui/local_files.rs:29
