msgstr ""
"Klicks auf freie Bereiche der Wiedergabeleiste wechseln die Visualisierung."

#: src/ui/settings.rs:1351 src/ui/settings.rs:2141
msgid "Frame rate"
msgstr "Bildrate"

#: src/ui/settings.rs:1354
