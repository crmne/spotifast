<!--
  Spotifast Tall. A white ceramic ribbon round a floating smoked-glass core. The
  pictures are cut from generated art by examples/ribbon_skin.rs, which also
  packs the skin.
-->
<THEME title="Spotifast Tall" author="Spotifast" copyright="Part of Spotifast">
<VIEW id="main" width="240" height="420" titleBar="false" backgroundColor="none" resizable="false"
      scriptFile="shape.js;ribbon.js" onLoad="boot();">
  <PLAYER playState_onChange="followPlayer();" currentMedia_onChange="followPlayer();"/>
  <EQUALIZERSETTINGS id="eq"/>

  <!-- Two hidden elements keep time: the engine moves them, the script reads. -->
  <SUBVIEW id="clock" visible="false" width="1" height="1"/>
  <SUBVIEW id="ticker" visible="false" width="1" height="1" onEndMove="tick();"/>

  <!-- The object. It is all there from the start at next to no alpha, so that
       every picture is decoded before the opening needs it, and it comes on
       at once when the wipe has finished. -->
  <SUBVIEW id="object" left="0" top="0" width="240" height="420" alphaBlend="1" passThrough="true">
    <!-- The square, showing through a hole in the glass. -->
    <SUBVIEW id="paneBack" left="62" top="75" width="126" height="126" zIndex="1" backgroundColor="#0a0c0e" visible="false"/>
    <SUBVIEW id="art" left="62" top="75" width="126" height="126" zIndex="2" visible="false" backgroundImage="wmpimage_albumart"
             onClick="togglePane();" cursor="hand"/>
    <SUBVIEW id="veilSlot" left="62" top="75" width="126" height="126" zIndex="4" passThrough="true">
      <SUBVIEW id="veil" left="0" top="0" backgroundImage="veil.png" passThrough="true" onEndMove="veilArrived();"/>
    </SUBVIEW>

    <SUBVIEW id="core" left="0" top="0" zIndex="5" backgroundImage="core.png"/>
    <!-- The visualizer fills the glass, cut to its shape, under the ribbon and
         the light. The rim softens that cut, and what is on the page draws
         over all of it. -->
    <SUBVIEW id="visual" left="34" top="46" width="176" height="276" zIndex="5" visible="false" alphaBlend="0"
             backgroundImage="glass_mask.png" clippingColor="#ff00ff" passThrough="true">
      <EFFECTS id="fx" left="0" top="0" width="176" height="276" onClick="togglePane();" cursor="hand"/>
      <SUBVIEW id="scrim" left="0" top="0" zIndex="1" backgroundImage="scrim.png" passThrough="true"/>
      <SUBVIEW id="rim" left="0" top="0" zIndex="2" backgroundImage="glass_rim.png" passThrough="true"/>
    </SUBVIEW>
    <SUBVIEW id="ribbon" left="0" top="0" zIndex="6" backgroundImage="ribbon.png"/>
    <SUBVIEW id="light" left="0" top="0" zIndex="7" alphaBlend="0" backgroundImage="light.png" passThrough="true"/>

    <!-- What wakes on the glass. -->
    <SUBVIEW id="screen" left="0" top="0" width="240" height="420" zIndex="8" alphaBlend="0" passThrough="true">
      <BUTTON id="pageButton" left="74" top="59" width="24" height="11" onClick="nextPage();" upToolTip="Now Playing, Equalizer, Queue"
              image="page0.png" hoverImage="page0.png" downImage="page0.png"/>
      <MINIMIZEBUTTON id="minButton" left="152" top="59" image="w_min.png" hoverImage="w_min_hover.png" downImage="w_min_down.png"/>
      <RETURNBUTTON id="returnButton" left="166" top="59" image="w_back.png" hoverImage="w_back_hover.png" downImage="w_back_down.png"/>
      <BUTTON id="closeButton" left="180" top="59" onClick="shutDown();" upToolTip="Close" image="w_close.png" hoverImage="w_close_hover.png" downImage="w_close_down.png"/>

      <SUBVIEW id="nowPage" left="0" top="0" width="240" height="420" passThrough="true">
        <EFFECTS id="wave" left="63" top="205" width="125" height="24" wave="true" foregroundColor="#39ff88" passThrough="true"/>
        <TEXT id="title" left="63" top="233" width="125" height="18" fontSize="11" fontStyle="bold" foregroundColor="#f2f4f6"
              scrollingAmount="1" scrollingDelay="40" value=""/>
        <TEXT id="artist" left="63" top="251" width="125" height="14" fontSize="8" foregroundColor="#a9b1bc"
              scrollingAmount="1" scrollingDelay="40" value=""/>
        <TEXT id="time" left="63" top="267" width="60" height="13" fontSize="7" foregroundColor="#f2f4f6"
              value="wmpprop:player.controls.currentPositionString"/>
        <BUTTON id="paneButton" left="176" top="267" onClick="togglePane();" upToolTip="Album art or visualizer"
                image="w_pane.png" hoverImage="w_pane_hover.png" downImage="w_pane_down.png"/>
        <SEEKSLIDER id="seek" left="63" top="281" width="127" height="9" backgroundImage="seek_back.png" foregroundImage="seek_fill.png"
                    thumbImage="thumb.png" thumbHoverImage="thumb_hot.png" thumbDownImage="thumb_hot.png" slide="false" cursor="hand"/>
      </SUBVIEW>

      <SUBVIEW id="eqPage" left="0" top="0" width="240" height="420" visible="false" passThrough="true">
        <TEXT left="63" top="76" width="90" height="17" fontSize="10" fontStyle="bold" foregroundColor="#f2f4f6" value="Equalizer"/>
        <BUTTON id="eqPower" left="168" top="79" sticky="true" onClick="eq.enabled = down;" down="wmpprop:eq.enabled"
                upToolTip="Turn the equalizer on" downToolTip="Turn the equalizer off"
                image="switch_off.png" hoverImage="switch_off.png" downImage="switch_on.png"/>
        <SLIDER id="preamp" left="62" top="102" width="9" height="150" direction="vertical" min="-12" max="12"
                backgroundImage="eq_back.png" thumbImage="thumb.png" thumbHoverImage="thumb_hot.png" thumbDownImage="thumb_hot.png"
                value="wmpprop:eq.preamp" value_onChange="eq.preamp = value;" cursor="hand" toolTip="Preamp"/>
<!-- @bands -->
        <TEXT id="eqName" left="63" top="258" width="125" height="14" fontSize="8" foregroundColor="#a9b1bc" cursor="hand"
              value="wmpprop:eq.currentPresetTitle" onClick="eq.nextPreset();" toolTip="Next preset"/>
      </SUBVIEW>

      <SUBVIEW id="queuePage" left="0" top="0" width="240" height="420" visible="false" passThrough="true">
        <TEXT left="63" top="76" width="125" height="17" fontSize="10" fontStyle="bold" foregroundColor="#f2f4f6" value="Queue"/>
        <PLAYLIST id="queue" left="60" top="98" width="134" height="195" backgroundColor="none" foregroundColor="#a9b1bc"
                  itemPlayingColor="#1ed760" itemSelectedColor="#f2f4f6" itemSelectedBackgroundColor="#2a3038"
                  columns="name=Name;Duration=Time" columnsVisible="false" dropdownVisible="false" fontSize="7"
                  onClick="playRow();"/>
      </SUBVIEW>

      <MUTEBUTTON id="mute" left="66" top="373" image="speaker.png" hoverImage="speaker_hover.png" downImage="speaker_down.png"/>
      <VOLUMESLIDER id="volume" left="91" top="377" width="82" height="9" backgroundImage="volume_back.png" foregroundImage="volume_fill.png"
                    thumbImage="thumb.png" thumbHoverImage="thumb_hot.png" thumbDownImage="thumb_hot.png" slide="false" cursor="hand"/>
    </SUBVIEW>

    <SUBVIEW id="pill" left="0" top="310" width="240" height="56" zIndex="9" alphaBlend="0" passThrough="true">
      <PREVBUTTON id="prevButton" left="70" top="19" image="prev.png" hoverImage="prev_hover.png" downImage="prev_down.png" disabledImage="prev_off.png"/>
      <PLAYBUTTON id="playButton" left="103" top="13" image="play.png" hoverImage="play_hover.png" downImage="play_down.png" disabledImage="play_off.png"/>
      <PAUSEBUTTON id="pauseButton" left="103" top="13" visible="false" image="pause.png" hoverImage="pause_hover.png" downImage="pause_down.png" disabledImage="pause_off.png"/>
      <NEXTBUTTON id="nextButton" left="148" top="19" image="next.png" hoverImage="next_hover.png" downImage="next_down.png" disabledImage="next_off.png"/>
    </SUBVIEW>
  </SUBVIEW>

  <!-- The opening: a thread of light round the outline, then the whole object
       wiped on behind it. Neither takes a click. -->
  <CUSTOMSLIDER id="wipe" left="0" top="0" width="240" height="420" zIndex="2" image="wipe.png" min="0" max="7" value="0"/>
  <CUSTOMSLIDER id="trace" left="0" top="0" width="240" height="420" zIndex="3" image="trace.png" min="0" max="13" value="0"/>
</VIEW>
</THEME>
