<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>rocks.spotifast.Spotifast</id>
  <name>Spotifast</name>
  <summary>A native Spotify client</summary>
  <developer id="me.paolino">
    <name>Carmine Paolino</name>
  </developer>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <description>
    <p>
      A Spotify client written in Rust with no browser engine. It starts
      in well under a second, plays music on this computer, and controls other
      Spotify Connect devices.
    </p>
    <p>
      Browse your library, search Spotify, edit playlists, manage the queue,
      and view lyrics. It also has keyboard shortcuts, media-key support,
      background playback, and a mini player for classic Winamp skins.
      Playback needs Spotify Premium.
    </p>
  </description>
  <launchable type="desktop-id">rocks.spotifast.Spotifast.desktop</launchable>
  <url type="homepage">https://spotifast.rocks/</url>
  <url type="bugtracker">https://github.com/crmne/spotifast/issues</url>
  <url type="help">https://spotifast.rocks/getting-started/</url>
  <url type="vcs-browser">https://github.com/crmne/spotifast</url>
  <screenshots>
    <screenshot type="default">
      <caption>A playlist, with the queue open and a track playing on a remote speaker</caption>
      <image>https://raw.githubusercontent.com/crmne/spotifast/main/docs/screenshot.png</image>
    </screenshot>
    <screenshot>
      <caption>The mini player wearing the built-in Winamp skin</caption>
      <image>https://raw.githubusercontent.com/crmne/spotifast/main/docs/assets/images/winamp.png</image>
    </screenshot>
  </screenshots>
  <branding>
    <color type="primary" scheme_preference="light">#1ed760</color>
    <color type="primary" scheme_preference="dark">#144a2a</color>
  </branding>
  <content_rating type="oars-1.1" />
  <requires>
